<?xml version="1.0" encoding="utf-8"?>
<Container version="2">
  <Name>AutoBuddy</Name>
  <Repository>ghcr.io/deltrivx/autobuddy:latest</Repository>
  <Registry>https://ghcr.io/deltrivx/autobuddy</Registry>
  <Network>bridge</Network>
  <MyIP />
  <MyMAC />
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/deltrivx/AutoBuddy/issues</Support>
  <Project>https://github.com/deltrivx/AutoBuddy</Project>
  <ReadMe>https://raw.githubusercontent.com/deltrivx/AutoBuddy/main/README.md</ReadMe>
  <Overview>AutoBuddy 是面向 NAS 与服务器打造的多账号管理套件与 OpenAI 兼容网关。内置 SQLite 数据库持久化存储系统配置与用户认证凭据；Web 控制台支持多账号自动签到保活、积分用量监控与 Token 调用流水；内置网关将大模型以标准 /v1 接口输出给各类 Agent 客户端；内置 GitHub 账号自动化接入（容器内置 Chromium 自动下载至挂载卷，配置在 WebUI 页面直接落库）。</Overview>
  <Category>AI:Tools:Productivity:</Category>
  <WebUI>http://[IP]:[PORT:18090]/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/deltrivx/AutoBuddy/main/unraid/autobuddy.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/deltrivx/AutoBuddy/main/icon.png</Icon>
  <ExtraParams>--shm-size=1g --restart=unless-stopped --log-opt max-size=50m --log-opt max-file=1 --health-cmd='curl -fsS http://127.0.0.1:18091/health || exit 1' --health-interval=60s --health-timeout=10s --health-retries=3 --health-start-period=120s</ExtraParams>
  <PostArgs />
  <CPUset />
  <DonateText />
  <DonateLink />
  <Requires />

  <!-- 端口映射 -->
  <Config Name="WebUI 端口" Target="18090" Default="18090" Mode="tcp" Description="AutoBuddy 管理面板访问端口（提供账号管理、自动签到、用量监控与 API 接入）" Type="Port" Display="always" Required="true" Mask="false">18090</Config>
  <Config Name="OpenAI API 端口" Target="18091" Default="18091" Mode="tcp" Description="OpenAI 兼容 API 网关端口（输出标准 /v1 接口供各类 AI 客户端接入）" Type="Port" Display="always" Required="true" Mask="false">18091</Config>
  
  <!-- 持久化挂载路径（遵循全小写规范） -->
  <Config Name="数据持久化目录" Target="/data" Default="/mnt/user/appdata/autobuddy/data" Mode="rw" Description="数据根目录：存储 SQLite 数据库 (autobuddy.db)、账号 Token、系统配置与统计流水" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/autobuddy/data</Config>
  <Config Name="浏览器缓存目录" Target="/data/.autobuddy/browsers" Default="/mnt/user/appdata/autobuddy/browsers" Mode="rw" Description="Playwright 浏览器内核持久化目录：首次启动自动下载并持久化，容器升级与重建无需重复下载" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/autobuddy/browsers</Config>

  <!-- 用户认证凭据（强制认证，可通过环境变量覆盖或在页面修改） -->
  <Config Name="WebUI 管理员账号" Target="AUTH_USERNAME" Default="admin" Mode="" Description="控制台登录账号（未配置时默认使用 admin）" Type="Variable" Display="always" Required="false" Mask="false">admin</Config>
  <Config Name="WebUI 管理员密码" Target="AUTH_PASSWORD" Default="password" Mode="" Description="控制台登录密码（未配置时默认使用 password，可在登录后于页面自行修改）" Type="Variable" Display="always" Required="false" Mask="true">password</Config>
  <!-- 运行环境 -->
  <Config Name="容器时区" Target="TZ" Default="Asia/Shanghai" Mode="" Description="容器运行时区（确保签到任务与用量统计按中国标准时间归集）" Type="Variable" Display="always" Required="false" Mask="false">Asia/Shanghai</Config>
</Container>
